# Force-include optional dependencies during install. The Claude Agent SDK
# ships its per-platform CLI binary as an optional dep
# (e.g. @anthropic-ai/claude-agent-sdk-linux-x64). Vercel's default install
# can prune optionals to shrink the build; this re-enables them so the
# linux-x64 binary lands in node_modules where the SDK can find it.
include=optional
